<?php

/**
 * @file
 * Hook implementations for the Backlit module.
 */

use Drupal\backlit\Render\BacklitPostRender;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_entity_view_alter().
 *
 * When render_mode is 'post_render', attaches a #post_render callback
 * to node render arrays for enabled bundles. The callback pipes the
 * rendered HTML through the lit-ssr binary to inject Declarative
 * Shadow DOM. The result is cached by Drupal's render cache.
 */
function backlit_entity_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display): void {
  if (!$entity instanceof NodeInterface) {
    return;
  }

  $config = \Drupal::config('backlit.settings');
  if ($config->get('render_mode') !== 'post_render') {
    return;
  }

  $enabled = $config->get('enabled_bundles') ?? [];
  if (!in_array($entity->bundle(), $enabled, TRUE)) {
    return;
  }

  $build['#post_render'][] = [BacklitPostRender::class, 'render'];
}
