{
  "name": "bennypowers/backlit",
  "description": "Server-render Lit web components from Drupal. No Node.js. No containers. Just vibes and NUL bytes.",
  "type": "drupal-module",
  "license": "MIT",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "Drupal\\backlit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Drupal\\Tests\\backlit\\": "tests/src/"
    }
  },
  "scripts": {
    "post-install-cmd": "bash scripts/download-binary.sh",
    "post-update-cmd": "bash scripts/download-binary.sh"
  },
  "extra": {
    "drupal": {
      "name": "backlit"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  }
}
